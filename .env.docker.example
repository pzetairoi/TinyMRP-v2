########################################
# TinyMRP v2 — Docker Compose (.env.docker)
########################################
#
# This file drives the SOURCE-BUILD compose stack at the repository root
# (app + mongo + redis + nginx, built from this checkout).
# For a guided VM/server install that generates all of this for you, use
# deploy/community/install.sh instead — see docs/deployment/01-vm-docker.md.
#
# Only three values normally need editing: TINYMRP_URL, DELIVERABLES_DIR, and
# the two secrets.

# The address a browser uses to reach this instance. INCLUDE THE SCHEME.
# It decides whether session cookies are marked `Secure` and whether the CSP
# upgrades subresources to https, so getting the scheme right is what makes a
# plain-HTTP LAN deployment work. Unset means "assume HTTPS".
#   http://localhost:5000        single machine
#   http://192.168.1.50:5000     LAN, reached by IP
#   https://tinymrp.example.com  behind a TLS reverse proxy
TINYMRP_URL=http://localhost:5000

# External HTTP port published by nginx. Must match the port in TINYMRP_URL.
HTTP_PORT=5000

# The bundled nginx is the only proxy in front of the app.
TINYMRP_TRUSTED_PROXY_HOPS=1

# Mongo settings (container-to-container)
MONGO_DB=tinymrp-v2
# Leave MONGO_URI unset — compose sets it for the app using the service name 'mongo'
# MONGO_URI=mongodb://mongo:27017/${MONGO_DB}

# Bind mount: host folder that directly contains edr/pdf/png/3mf/...
# Windows: use forward slashes
DELIVERABLES_DIR=C:/CADEXPORT

# URL prefix served by nginx inside the compose stack
FILES_URL_PREFIX=/Deliverables

# Optional upstream HTTP proxy for files (usually leave empty)
# FILES_UPSTREAM_BASE=
# FILES_UPSTREAM_ALLOWED_HOSTS=files.example.com
# FILES_PROXY_MAX_BYTES=2147483648
# UPLOAD_PACK_MAX_ZIP_MB=1024
# UPLOAD_PACK_MAX_FILE_MB=1024
# UPLOAD_PACK_MAX_FILES=5000
# EXTRA_FILES_ALLOWED=true

# Defaults to TINYMRP_URL. Set only when a DIFFERENT origin must call the API.
# TINYMRP_ALLOWED_ORIGINS=http://localhost:5000
# TINYMRP_CORS_CREDENTIALS=true
# New API tokens expire after 90 days by default and cannot exceed 365 days.
# API_TOKEN_DEFAULT_TTL_DAYS=90
# API_TOKEN_MAX_TTL_DAYS=365

# Secrets (replace before any non-development use)
# Must be at least 16 characters and not a placeholder. The application
# refuses to start otherwise: it used to generate and persist its own
# secrets when these were missing, which meant a restart could not tell a
# forged session from a real one.
SECRET_KEY=change-me-to-a-random-32-char-value
SECURITY_PASSWORD_SALT=change-me-to-another-random-value

# Optional first-admin seed. Keep false unless the database is new, then supply
# both credentials explicitly. Startup fails rather than generating/logging one.
TINYMRP_SEED_ADMIN=false
# TINYMRP_ADMIN_EMAIL=admin@example.com
# TINYMRP_ADMIN_PASSWORD=replace-with-a-unique-strong-password
# ALLOW_PERMISSION_TEST_DATA=false  # disposable development/test instances only.
# Only the INITIAL default: administrators can now turn the permission-test
# environment on and off from the admin dashboard without editing this file.

# How to use:
#   docker compose --env-file .env.docker up -d --build
