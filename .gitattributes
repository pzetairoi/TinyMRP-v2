# Keep frontend inputs and generated bundles byte-stable across Windows and Linux.
frontend/** text eol=lf
app/static/parts-ui/** text eol=lf

# Do not apply text conversion to binary frontend assets.
frontend/**/*.png binary
frontend/**/*.jpg binary
frontend/**/*.jpeg binary
frontend/**/*.gif binary
frontend/**/*.ico binary
frontend/**/*.webp binary
frontend/**/*.woff binary
frontend/**/*.woff2 binary
frontend/**/*.ttf binary
frontend/**/*.eot binary
frontend/**/*.wasm binary
app/static/parts-ui/**/*.png binary
app/static/parts-ui/**/*.jpg binary
app/static/parts-ui/**/*.jpeg binary
app/static/parts-ui/**/*.gif binary
app/static/parts-ui/**/*.ico binary
app/static/parts-ui/**/*.webp binary
app/static/parts-ui/**/*.woff binary
app/static/parts-ui/**/*.woff2 binary
app/static/parts-ui/**/*.ttf binary
app/static/parts-ui/**/*.eot binary
app/static/parts-ui/**/*.wasm binary

# These files execute in Linux containers and hosts.
*.sh text eol=lf

# Owner-approved engineering sample dataset. Keep CAD/drawing payloads byte-stable.
sample_data/**/*.3mf binary
sample_data/**/*.dxf binary
sample_data/**/*.easm binary
sample_data/**/*.edrw binary
sample_data/**/*.eprt binary
sample_data/**/*.pdf binary
sample_data/**/*.ply binary
sample_data/**/*.png binary
sample_data/**/*.step binary
sample_data/**/*.stl binary
sample_data/**/*.zip binary
sample_data/**/*.json text eol=lf
sample_data/**/*.md text eol=lf
