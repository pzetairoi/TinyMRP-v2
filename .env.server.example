########################################
# TinyMRP v2 — Ubuntu Server (no containers)
########################################

# Run MongoDB locally or point to a remote cluster
MONGO_URI=mongodb://localhost:27017/tinymrp-v2

# Folder on server with Deliverables (edr/pdf/png/3mf/...)
FILES_LOCAL_ROOT=/srv/tinymrp/deliverables

# Nginx will serve this prefix and alias it to FILES_LOCAL_ROOT
FILES_URL_PREFIX=/Deliverables

SECRET_KEY=please-change
SECURITY_PASSWORD_SALT=please-change-too

# Security mode (compat by default)
TINYMRP_SECURITY_MODE=compat
# TINYMRP_ALLOWED_ORIGINS=https://your-ui.example.com
# TINYMRP_CORS_CREDENTIALS=false

# --- Phase 1 security controls ---
# Rate limiting (on by default; login/password endpoints are throttled)
# RATE_LIMIT_ENABLED=true
# RATE_LIMIT_LOGIN=10 per minute;100 per hour
# RATE_LIMIT_API=600 per minute            # optional global /api budget per client
# RATE_LIMIT_STORAGE_URI=redis://127.0.0.1:6379/0   # required for multi-worker gunicorn

# Tokenized file links expire after this many seconds (default 86400 = 24h; 0 = never)
# FILES_TOKEN_TTL_SECONDS=86400
# Accept pre-TTL (legacy, non-expiring) tokens during a migration window only:
# FILES_ALLOW_LEGACY_TOKENS=false

# Two-factor authentication (TOTP authenticator apps; default off)
# SECURITY_TWO_FACTOR_ENABLED=true
# SECURITY_TWO_FACTOR_REQUIRED=false
# Generate with: python -c "from passlib import totp; print(totp.generate_secret())"
# SECURITY_TOTP_SECRETS=

# Logging
# LOG_LEVEL=INFO
# LOG_FORMAT=json          # json lines for aggregation; default is text
# REMEMBER_COOKIE_DAYS=7

# CSP: set to false only after migrating admin inline scripts (see plan Phase 1.5)
# TINYMRP_CSP_ALLOW_INLINE=true

# Optional
# FILES_UPSTREAM_BASE=
# FILES_UPSTREAM_ALLOWED_HOSTS=files.example.com
# FILES_PROXY_MAX_BYTES=2147483648
# FILE_HASH_MAX_BYTES=0
# UPLOAD_PACK_MAX_ZIP_MB=1024
# UPLOAD_PACK_MAX_FILE_MB=1024
# UPLOAD_PACK_MAX_FILES=5000
# EXTRA_FILES_ALLOWED=true
# First-admin bootstrap is opt-in and requires both explicit credentials.
# TINYMRP_SEED_ADMIN=false
# TINYMRP_ADMIN_EMAIL=admin@example.com
# TINYMRP_ADMIN_PASSWORD=replace-with-a-unique-strong-password
# ALLOW_PERMISSION_TEST_DATA=false  # disposable development/test instances only

# For systemd EnvironmentFile=/etc/tinymrp/.env, copy this there
