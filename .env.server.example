########################################
# TinyMRP v2 — Ubuntu Server (no containers)
########################################
#
# THE THREE SETTINGS THAT MATTER: TINYMRP_URL, FILES_LOCAL_ROOT, and the two
# secrets. Everything below them has a working default.
# Full guide: docs/deployment/02-linux-bare-metal.md

# The address a browser uses to reach this instance. INCLUDE THE SCHEME.
# It decides whether session cookies are marked `Secure` and whether the CSP
# upgrades subresources to https, so an http:// value here is what makes a
# plain-HTTP LAN deployment work at all. Unset means "assume HTTPS".
#   LAN over plain HTTP:  http://192.168.1.50        (or http://tinymrp.lan)
#   Behind a TLS proxy:   https://tinymrp.example.com
TINYMRP_URL=https://tinymrp.example.com

# How many reverse proxies you control sit in front of the app.
#   1 = the documented Nginx/Caddy setup (default)
#   0 = gunicorn/waitress published directly, no proxy
# With a proxy that does not overwrite them, X-Forwarded-* headers are just
# client input: a forged X-Forwarded-For gives every request its own
# rate-limit bucket and a false address in the audit log.
TINYMRP_TRUSTED_PROXY_HOPS=1

# Run MongoDB locally or point to a remote cluster
MONGO_URI=mongodb://localhost:27017/tinymrp-v2

# Folder on server with Deliverables (edr/pdf/png/3mf/...)
FILES_LOCAL_ROOT=/srv/tinymrp/deliverables

# Nginx will serve this prefix and alias it to FILES_LOCAL_ROOT
FILES_URL_PREFIX=/Deliverables

# Must be at least 16 characters and not a placeholder. The application
# refuses to start otherwise: it used to generate and persist its own
# secrets when these were missing, which meant a restart could not tell a
# forged session from a real one.
SECRET_KEY=please-change-to-a-random-32-char-value
SECURITY_PASSWORD_SALT=please-change-to-another-random-value

# Defaults to TINYMRP_URL. Set only when a DIFFERENT origin must call the API.
# TINYMRP_ALLOWED_ORIGINS=https://your-ui.example.com
# TINYMRP_CORS_CREDENTIALS=false
# Override the transport posture derived from TINYMRP_URL. Almost never needed:
# set TINYMRP_URL correctly instead. true|false|auto (default auto).
# TINYMRP_BROWSER_TLS=auto
# New API tokens expire after 90 days by default and cannot exceed 365 days.
# API_TOKEN_DEFAULT_TTL_DAYS=90
# API_TOKEN_MAX_TTL_DAYS=365

# --- Phase 1 security controls ---
# Rate limiting (on by default; login/password endpoints are throttled)
# RATE_LIMIT_ENABLED=true
# RATE_LIMIT_LOGIN=10 per minute;100 per hour
# RATE_LIMIT_API=600 per minute            # optional global /api budget per client
# RATE_LIMIT_STORAGE_URI=redis://127.0.0.1:6379/0   # required for multi-worker gunicorn

# Tokenized file links expire after this many seconds (default 86400 = 24h; 0 = never)
# FILES_TOKEN_TTL_SECONDS=86400
# Accept pre-TTL (legacy, non-expiring) tokens during a migration window only:
# FILES_ALLOW_LEGACY_TOKENS=false

# Two-factor authentication (TOTP authenticator apps; default off)
# SECURITY_TWO_FACTOR_ENABLED=true
# SECURITY_TWO_FACTOR_REQUIRED=false
# Generate with: python -c "from passlib import totp; print(totp.generate_secret())"
# SECURITY_TOTP_SECRETS=

# Logging
# LOG_LEVEL=INFO
# LOG_FORMAT=json          # json lines for aggregation; default is text
# REMEMBER_COOKIE_DAYS=7

# CSP: set to false only after migrating admin inline scripts (see plan Phase 1.5)
# TINYMRP_CSP_ALLOW_INLINE=true

# Optional
# FILES_UPSTREAM_BASE=
# FILES_UPSTREAM_ALLOWED_HOSTS=files.example.com
# FILES_PROXY_MAX_BYTES=2147483648
# FILE_HASH_MAX_BYTES=0
# UPLOAD_PACK_MAX_ZIP_MB=1024
# UPLOAD_PACK_MAX_FILE_MB=1024
# UPLOAD_PACK_MAX_FILES=5000
# EXTRA_FILES_ALLOWED=true
# First-admin bootstrap is opt-in and requires both explicit credentials.
# TINYMRP_SEED_ADMIN=false
# TINYMRP_ADMIN_EMAIL=admin@example.com
# TINYMRP_ADMIN_PASSWORD=replace-with-a-unique-strong-password
# ALLOW_PERMISSION_TEST_DATA=false  # disposable development/test instances only.
# Only the INITIAL default: administrators can now turn the permission-test
# environment on and off from the admin dashboard without editing this file.

# For systemd EnvironmentFile=/etc/tinymrp/.env, copy this there
