<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ComVisible>true</ComVisible>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <RegisterForComInterop>false</RegisterForComInterop>
    <RootNamespace>TinyMRP.SolidWorksAddin</RootNamespace>
  </PropertyGroup>
  <PropertyGroup>
    <!-- AssemblyVersion remains stable for COM; Release builds advance BuildNumber.txt. -->
    <VersionPrefix>1.0.0</VersionPrefix>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <FileVersion>1.0.0.0</FileVersion>
    <InformationalVersion>0</InformationalVersion>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <BuildNumberFile>$(MSBuildProjectDirectory)\BuildNumber.txt</BuildNumberFile>
    <IncrementBuildNumber Condition="'$(Configuration)' == 'Release'">true</IncrementBuildNumber>
    <IncrementBuildNumber Condition="'$(IncrementBuildNumber)' == ''">false</IncrementBuildNumber>
  </PropertyGroup>
  <Target Name="ComputeBuildNumber" BeforeTargets="GetAssemblyAttributes">
    <Exec Command="powershell -NoProfile -ExecutionPolicy Bypass -File &quot;$(MSBuildProjectDirectory)\IncrementBuildNumber.ps1&quot; -Path &quot;$(BuildNumberFile)&quot; -Increment &quot;$(IncrementBuildNumber)&quot;"
          ConsoleToMSBuild="true" StandardOutputImportance="Low">
      <Output TaskParameter="ConsoleOutput" PropertyName="BuildNumberOutput" />
    </Exec>
    <PropertyGroup>
      <BuildNumber>$([System.String]::Copy('$(BuildNumberOutput)').Trim())</BuildNumber>
      <FileVersion>1.0.0.$(BuildNumber)</FileVersion>
      <InformationalVersion>$(BuildNumber)</InformationalVersion>
    </PropertyGroup>
    <Message Text="$(BuildNumber)" Importance="High" />
  </Target>
  <PropertyGroup>
    <SolidWorksApiDir>$(ProgramFiles)\SOLIDWORKS Corp\SOLIDWORKS\api\redist</SolidWorksApiDir>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="SolidWorks.Interop.sldworks">
      <HintPath>$(SolidWorksApiDir)\SolidWorks.Interop.sldworks.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="SolidWorks.Interop.swconst">
      <HintPath>$(SolidWorksApiDir)\SolidWorks.Interop.swconst.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="SolidWorks.Interop.swpublished">
      <HintPath>$(SolidWorksApiDir)\SolidWorks.Interop.swpublished.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="System.IO.Compression" />
    <Reference Include="System.IO.Compression.FileSystem" />
    <Reference Include="System.Net.Http" />
    <Reference Include="System.Security" />
    <Reference Include="System.Web.Extensions" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="Assets\logo.png">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Templates\TinyMRP_BOM_TEMPLATE.sldbomtbt">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Templates\TinyMRP_BLANKSHEET_TEMPLATE.slddrt">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="TinyMRP_config.txt">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>
</Project>
