<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ComVisible>true</ComVisible>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <RegisterForComInterop>false</RegisterForComInterop>
    <RootNamespace>TinyMRP.SolidWorksAddin</RootNamespace>
  </PropertyGroup>
  <PropertyGroup>
    <!-- Seed version; CI/local builds append a build identifier when git is available. -->
    <VersionPrefix>1.0.0</VersionPrefix>
    <!-- Keep AssemblyVersion stable for COM registration friendliness. -->
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <FileVersion>1.0.0.0</FileVersion>
    <InformationalVersion>$(VersionPrefix)</InformationalVersion>
    <!-- We generate our own git/timestamp informational version; don't let the SDK append full hashes automatically. -->
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
  </PropertyGroup>
  <PropertyGroup>
    <RepoRootDir>$(MSBuildProjectDirectory)\..\..</RepoRootDir>
  </PropertyGroup>
  <Target Name="ComputeBuildTimestamp" BeforeTargets="GetAssemblyAttributes">
    <PropertyGroup>
      <BuildTimestampUtc>$([System.DateTime]::UtcNow.ToString("yyyyMMddHHmmss"))</BuildTimestampUtc>
      <InformationalVersion>$(VersionPrefix)+build.$(BuildTimestampUtc)</InformationalVersion>
    </PropertyGroup>
  </Target>
  <Target Name="ComputeGitBuildVersion" DependsOnTargets="ComputeBuildTimestamp" BeforeTargets="GetAssemblyAttributes" Condition="Exists('$(RepoRootDir)\\.git') Or Exists('$(RepoRootDir)\\.git\\HEAD') Or Exists('$(MSBuildProjectDirectory)\\.git')">
    <Exec Command="git rev-list --count HEAD" WorkingDirectory="$(RepoRootDir)" ConsoleToMSBuild="true" IgnoreExitCode="true">
      <Output TaskParameter="ConsoleOutput" PropertyName="GitCommitCount" />
    </Exec>
    <Exec Command="git rev-parse --short=8 HEAD" WorkingDirectory="$(RepoRootDir)" ConsoleToMSBuild="true" IgnoreExitCode="true">
      <Output TaskParameter="ConsoleOutput" PropertyName="GitCommitHash" />
    </Exec>
    <PropertyGroup>
      <GitCommitCountTrim>$([System.String]::Copy('$(GitCommitCount)').Trim())</GitCommitCountTrim>
      <GitCommitHashTrim>$([System.String]::Copy('$(GitCommitHash)').Trim())</GitCommitHashTrim>
      <FileVersion Condition="'$(GitCommitCountTrim)' != ''">1.0.0.$(GitCommitCountTrim)</FileVersion>
      <InformationalVersion Condition="'$(GitCommitCountTrim)' != '' and '$(GitCommitHashTrim)' != ''">$(VersionPrefix)+build.$(GitCommitCountTrim).$(GitCommitHashTrim).$(BuildTimestampUtc)</InformationalVersion>
      <InformationalVersion Condition="'$(GitCommitCountTrim)' != '' and '$(GitCommitHashTrim)' == ''">$(VersionPrefix)+build.$(GitCommitCountTrim).$(BuildTimestampUtc)</InformationalVersion>
    </PropertyGroup>
  </Target>
  <PropertyGroup>
    <SolidWorksApiDir>$(ProgramFiles)\SOLIDWORKS Corp\SOLIDWORKS\api\redist</SolidWorksApiDir>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="SolidWorks.Interop.sldworks">
      <HintPath>$(SolidWorksApiDir)\SolidWorks.Interop.sldworks.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="SolidWorks.Interop.swconst">
      <HintPath>$(SolidWorksApiDir)\SolidWorks.Interop.swconst.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="SolidWorks.Interop.swpublished">
      <HintPath>$(SolidWorksApiDir)\SolidWorks.Interop.swpublished.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="System.IO.Compression" />
    <Reference Include="System.IO.Compression.FileSystem" />
    <Reference Include="System.Net.Http" />
    <Reference Include="System.Security" />
    <Reference Include="System.Web.Extensions" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="Assets\logo.png">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Templates\TinyMRP_BOM_TEMPLATE.sldbomtbt">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Templates\TinyMRP_BLANKSHEET_TEMPLATE.slddrt">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="TinyMRP_config.txt">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>
</Project>
