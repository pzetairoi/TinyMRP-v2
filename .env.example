########################################
# TinyMRP v2 – Example .env
########################################

# --- Secrets ---
SECRET_KEY=change-me
SECURITY_PASSWORD_SALT=change-me-too

# --- Database ---
MONGO_DB=tinymrp-v2
MONGO_URI=mongodb://mongo:27017/${MONGO_DB}

# --- Host ports ---
# Single knob for external HTTP port (nginx)
HTTP_PORT=5000

# --- Files (single path to set) ---
# Set this to your host folder containing deliverables (mounted read-only)
DELIVERABLES_DIR=Z:/Deliverables

# Optional URL prefix (nginx serves this path)
FILES_URL_PREFIX=/deliverables

# Optional: proxy external file server (disable unless needed)
# FILES_UPSTREAM_BASE=http://192.168.0.10

# --- Frontend dev only ---
# Vite dev server proxies API and files to this backend URL
VITE_BACKEND_URL=http://localhost:5000

