# External port for NGINX
HTTP_PORT=5000

# Mongo
MONGO_DB=tinymrp-v2
MONGO_URI=mongodb://mongo:27017/tinymrp-v2

# App secret
SECRET_KEY=please-change-me

# Point this to your host path containing folders: png, pdf, dxf, step, edr, 3mf, datasheet, thumbs
# Windows example:
DELIVERABLES_DIR=Z:/Deliverables
# Linux example:
# DELIVERABLES_DIR=/mnt/Deliverables

# The app reads either FILE_ROOTS or FILE_ROOTS_JSON
FILE_ROOTS={"local":"/data/deliverables","http":"/Deliverables"}
FILE_ROOTS_JSON={"local":"/data/deliverables","http":"/Deliverables"}
