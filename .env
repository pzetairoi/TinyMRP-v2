# Local folder the Flask server can read (Windows tip: use forward slashes)
FILE_ROOT_LOCAL=Z:/Deliverables

# Upstream base URL (your file server, Apache/IIS/Nginx, etc) for proxy file serving
# If your file server is on the same machine as this Flask app, use localhost
FILES_UPSTREAM_BASE=http://192.168.0.198


# HTTP base that serves the same files (your Apache/IIS/Nginx)
FILE_ROOT_HTTP=http://192.168.0.198/Deliverables


# Optional: compute SHA-256 for files up to this size (bytes). 0 = disable
FILE_HASH_MAX_BYTES=10485760


# Thumbnails
THUMB_SUBDIR=thumbs
THUMB_MAX_W=320
THUMB_MAX_H=240
THUMB_FORMAT=PNG          # keep as PNG for crisp line drawings
THUMB_QUALITY=88          # used if switched to JPEG later


