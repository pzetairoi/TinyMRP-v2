########################################
# TinyMRP v2 — Local Dev (.env.dev) - FOR PYTHON RUN
########################################
# Relys on having an  nginx container running (see docs/planning/handycommands.txt)
# docker run --rm -d --name tinymrp-nginx-static -p 5001:80 -v "${PWD}/docker/nginx/nginx.static.conf:/etc/nginx/nginx.conf:ro" -v "${env:FILES_LOCAL_ROOT}:/data/deliverables:ro" nginx:1.27-alpine

# ---------------------------------------------------------------------------
# The address a browser uses to reach this instance. INCLUDE THE SCHEME.
#
# This single value decides whether session cookies are marked `Secure` and
# whether the CSP asks browsers to upgrade subresources to https. Declare
# http:// and you get a session a plain-HTTP client can actually keep; declare
# https:// and you get the full TLS posture. Leave it unset and TinyMRP assumes
# HTTPS, which is safe but produces a login loop on a plain-HTTP LAN address.
#
# Local dev:  http://localhost:5000
# LAN dev:    http://192.168.1.50:5000   (use the IP other machines will type)
# See docs/deployment/05-configuration-reference.md
TINYMRP_URL=http://localhost:5000

# Use your local MongoDB
MONGO_URI=mongodb://localhost:27017/tinymrp-v2

# Folder on your host with Deliverables (edr/pdf/png/3mf/...)
# Windows: use forward slashes
FILES_LOCAL_ROOT=C:/testcloud/TinyMRP - test Deliverables

# Where the browser should fetch files during dev
# Recommended: avoid CORS by serving files via Flask proxy at the SAME origin
# (Flask will proxy to the helper nginx at :5001 under the hood)
FILES_URL_PREFIX=/deliverables
# Point the proxy to the helper nginx base URL
FILES_UPSTREAM_BASE=http://localhost:5001

# Secrets (ok to use simple values for local dev)
# Must be at least 16 characters and not a placeholder. The application
# refuses to start otherwise: it used to generate and persist its own
# secrets when these were missing, which meant a restart could not tell a
# forged session from a real one.
SECRET_KEY=dev-only-secret-key-change-me
SECURITY_PASSWORD_SALT=dev-only-password-salt-change-me

VITE_BACKEND_URL=http://localhost:5000


TINYMRP_CSP_REPORT_ONLY_STRICT=true
# Nothing runs in front of `python run.py`, so no X-Forwarded-* header can be
# trusted. Leave at 0 unless you put a reverse proxy in front.
TINYMRP_TRUSTED_PROXY_HOPS=0
# Defaults to TINYMRP_URL. Only set this when a DIFFERENT origin (such as the
# Vite dev server on :5173) must call the API cross-origin.
# TINYMRP_ALLOWED_ORIGINS=http://localhost:5000,http://localhost:5173
# TINYMRP_CORS_CREDENTIALS=true
# API_TOKEN_DEFAULT_TTL_DAYS=90
# API_TOKEN_MAX_TTL_DAYS=365
# TINYMRP_SEED_ADMIN=true
# TINYMRP_ADMIN_EMAIL=admin@example.com
# TINYMRP_ADMIN_PASSWORD=replace-with-a-unique-strong-password
# Initial default only - the admin dashboard can toggle this at runtime.
ALLOW_PERMISSION_TEST_DATA=true  # disposable development/test instances only
# FILES_UPSTREAM_BASE=http://files.example.com
# FILES_UPSTREAM_ALLOWED_HOSTS=files.example.com
# FILES_PROXY_MAX_BYTES=2147483648
# FILE_HASH_MAX_BYTES=0
# UPLOAD_PACK_MAX_ZIP_MB=1024
# UPLOAD_PACK_MAX_FILE_MB=1024
# UPLOAD_PACK_MAX_FILES=5000
# EXTRA_FILES_ALLOWED=true

# Tell the app to load this file explicitly:
#   PowerShell:  $env:ENV_FILE=".env.dev"; python run.py
#   Bash:        ENV_FILE=.env.dev python run.py
