# docker/.env.overlay
# Mark we are in Docker so your runtime helper can auto-pick internal defaults
RUNNING_IN_DOCKER=1

# Let the app choose the docker Mongo default (mongo:27017) unless you explicitly override
FILE_ROOT_LOCAL=/data/deliverables
MONGO_URI=mongodb://mongo:27017/tinymrp-v2
FILE_ROOT_HTTP=http://192.168.0.198/Deliverables


# The manifest path inside the image
VITE_MANIFEST=/app/app/static/parts-ui/.vite/manifest.json

# External port for NGINX
HTTP_PORT=5000

# Mongo
MONGO_DB=tinymrp-v2


# Point this to your host path containing folders: png, pdf, dxf, step, edr, 3mf, datasheet, thumbs
# Windows example:
DELIVERABLES_DIR=C:\CADEXPORT
# Linux example:
# DELIVERABLES_DIR=/mnt/Deliverables

# The app reads either FILE_ROOTS or FILE_ROOTS_JSON
FILE_ROOTS={"local":"/data/deliverables","http":"/Deliverables"}
FILE_ROOTS_JSON={"local":"/data/deliverables","http":"/Deliverables"}

