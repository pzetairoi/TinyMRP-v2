########################################################################
# TinyMRP - Windows, restricted environment, run.py
#
# For a locked-down host where "python.exe run.py" is the one approved
# command: no Docker, no new services, no new executables.
#
# Copy to C:\TinyMRP\config\.env.lan and edit the four REQUIRED values.
# Start with:  deploy\windows-restricted\start-tinymrp.cmd
# Check with:  deploy\windows-restricted\check-restricted-install.ps1
# Guide:       docs/deployment/12-restricted-windows-flask.md
########################################################################

# ---------------------------------------------------------------------
# REQUIRED 1/4 - the address users type, scheme and port included.
#
# THIS IS THE SETTING THAT DECIDES WHETHER LOGIN WORKS AT ALL.
#
# Its scheme tells TinyMRP whether browsers reach it over TLS. With
# http:// the session cookie is storable on a plain-HTTP origin and the
# page does not ask browsers to upgrade its assets to https. Leave it
# unset and TinyMRP assumes HTTPS: the browser then throws the session
# cookie away and every login returns
#   "CSRF session token is missing"
# with no clue as to why.
#
# run.py also derives the listening port from this value, so the address
# and the listener cannot drift apart.
# ---------------------------------------------------------------------
TINYMRP_URL=http://tinymrp.local:5555

# ---------------------------------------------------------------------
# REQUIRED 2/4 - the deliverables folder. Forward slashes.
# Must be writable by the account that runs run.py: thumbnails, uploads
# and extra files are written underneath it.
# ---------------------------------------------------------------------
FILES_LOCAL_ROOT=C:/TinyMRP/data/deliverables

# ---------------------------------------------------------------------
# REQUIRED 3/4 and 4/4 - two different random secrets, 32+ characters.
#
# The app REFUSES TO START without them. It no longer generates its own:
# a key invented at boot changes on every restart, and an application
# that re-keys itself cannot tell a forged session from a real one.
# If your instance stopped starting after an update with
#   RuntimeError: SECRET_KEY must be set to a strong value.
# this is why - older builds generated these into instance\.
#
# Generate each with:
#   powershell -c "[guid]::NewGuid().ToString('N') + [guid]::NewGuid().ToString('N')"
#
# Keep a copy with your backups. Losing SECRET_KEY signs everyone out;
# losing SECURITY_PASSWORD_SALT invalidates every stored password.
# ---------------------------------------------------------------------
SECRET_KEY=REPLACE-WITH-A-64-CHAR-RANDOM-VALUE
SECURITY_PASSWORD_SALT=REPLACE-WITH-A-DIFFERENT-64-CHAR-RANDOM-VALUE

########################################################################
# Below here: defaults that work. Change only with a reason.
########################################################################

# Nothing sits in front of this process, so no X-Forwarded-* header can
# be believed. Leave 0 unless you add a reverse proxy: otherwise a client
# can send its own X-Forwarded-For and get a private rate-limit bucket.
TINYMRP_TRUSTED_PROXY_HOPS=0

# MongoDB on this machine. Keep bindIp 127.0.0.1 in mongod.cfg so the
# database is never reachable from the network.
MONGO_URI=mongodb://127.0.0.1:27017/tinymrp-v2

# Managed files are served by the app so permissions are enforced.
FILES_URL_PREFIX=/deliverables
FILES_PUBLIC_URLS=false
# No reverse proxy here, so there is no X-Accel-Redirect to hand off to.
FILES_ACCEL_REDIRECT_PREFIX=

# No TLS on this deployment, so nothing may redirect to https.
FORCE_HTTPS=false

# --- How run.py listens -------------------------------------------------
# Both are derived from TINYMRP_URL and rarely need setting:
#   host = 0.0.0.0 when TINYMRP_URL names a non-loopback host
#   port = the port in TINYMRP_URL
# Uncomment only to override.
# TINYMRP_BIND_HOST=0.0.0.0
# TINYMRP_BIND_PORT=5555
#
# Server: waitress (default when installed) or flask. Waitress is a pure
# Python package already in requirements.txt and runs inside the same
# python.exe, so it needs no new approved executable.
# TINYMRP_SERVER=waitress
# TINYMRP_THREADS=8
# TINYMRP_CONNECTION_LIMIT=200
# TINYMRP_CHANNEL_TIMEOUT=120
#
# TINYMRP_DEV=1 turns on the Flask debugger and reloader. run.py REFUSES
# to combine it with a network-facing bind, because Werkzeug's traceback
# console executes arbitrary Python in this process.
# TINYMRP_DEV=1

# CORS defaults to TINYMRP_URL. Set only if users reach the server by a
# second address as well (for example the raw IP).
# TINYMRP_ALLOWED_ORIGINS=http://tinymrp.local:5555,http://192.168.0.25:5555

# Rate limiting. One process, so in-memory counters are a real budget and
# Redis is not needed.
# RATE_LIMIT_ENABLED=true
# RATE_LIMIT_LOGIN=10 per minute;100 per hour

LOG_LEVEL=INFO
LOG_FORMAT=text

# First administrator: prefer `flask user bootstrap-admin`, which prompts
# without echoing, over storing a password here.
TINYMRP_SEED_ADMIN=false
# TINYMRP_ADMIN_EMAIL=admin@company.com
# TINYMRP_ADMIN_PASSWORD=

# Evaluation dataset and demo logins. Prefer `flask demo install`.
# ALLOW_PERMISSION_TEST_DATA=false

# Upload ceilings. TINYMRP_MAX_CONTENT_MB is the hard request cap and
# defaults to min(UPLOAD_PACK_MAX_ZIP_MB, 200), so raise it too.
UPLOAD_PACK_MAX_ZIP_MB=500
UPLOAD_PACK_MAX_FILE_MB=200
UPLOAD_PACK_MAX_FILES=5000
# TINYMRP_MAX_CONTENT_MB=500

# API tokens issued to the SolidWorks add-in.
# API_TOKEN_DEFAULT_TTL_DAYS=90
# API_TOKEN_MAX_TTL_DAYS=365
