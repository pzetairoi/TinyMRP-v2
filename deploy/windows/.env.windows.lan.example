########################################
# TinyMRP v2 - Windows LAN-Only (Simple)
#
# Copy to: C:\TinyMRP\config\.env.lan
# The service script sets ENV_FILE to point there.
########################################


# Generate long random values (at least 32 bytes each).
# Must be at least 16 characters and not a placeholder. The application
# refuses to start otherwise: it used to generate and persist its own
# secrets when these were missing, which meant a restart could not tell a
# forged session from a real one.
SECRET_KEY=replace-with-a-random-32-character-secret
SECURITY_PASSWORD_SALT=replace-with-a-random-32-character-salt

# If MongoDB is on a separate host, replace 127.0.0.1 with that host/IP.
# Keep MongoDB reachable only from the TinyMRP server.
MONGO_URI=mongodb://127.0.0.1:27017/tinymrp-v2

# Deliverables root used by app + NGINX alias.
FILES_LOCAL_ROOT=C:/TinyMRP/data/deliverables
FILES_URL_PREFIX=/Deliverables
FILES_PUBLIC_URLS=false
FILES_ACCEL_REDIRECT_PREFIX=/__files

# No HTTPS redirect in this profile.
FORCE_HTTPS=false
SECURITY_HEADERS_ENABLED=true

# If users browse http://tinymrp-lan.company.local, set it below.
TINYMRP_ALLOWED_ORIGINS=http://tinymrp-lan.company.local
TINYMRP_CORS_CREDENTIALS=true

# Upload guardrails (adjust for your CAD package sizes).
UPLOAD_PACK_MAX_ZIP_MB=500
UPLOAD_PACK_MAX_FILE_MB=200
UPLOAD_PACK_MAX_FILES=5000
EXTRA_FILES_ALLOWED=true

# Keep permission-test account and DEMO-record controls disabled on real instances.
# Initial default only - the admin dashboard can toggle this at runtime.
ALLOW_PERMISSION_TEST_DATA=false
