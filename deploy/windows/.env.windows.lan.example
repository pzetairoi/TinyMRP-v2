########################################################################
# TinyMRP v2 - Windows LAN deployment (no Docker)
#
# Copy to C:\TinyMRP\config\.env.lan and edit the four REQUIRED values.
# Everything else already has a working default.
#
# Full walkthrough: docs/deployment/03-windows-lan.md
########################################################################

# ---------------------------------------------------------------------
# REQUIRED 1/4 - the address people type in their browser.
#
# INCLUDE THE SCHEME. This value is what tells TinyMRP whether browsers
# reach it over TLS. Declaring http:// keeps session cookies storable on a
# plain-HTTP origin and stops the CSP from upgrading page assets to https.
# If it is missing or wrong, login succeeds and immediately bounces back to
# the login form, because the browser threw the session cookie away.
#
# Must match server_name in nginx.lan.conf and the port nginx listens on.
#   http://tinymrp-lan.company.local     (nginx on port 80)
#   http://192.168.0.25                  (no DNS entry; users type the IP)
#   http://192.168.0.25:8080             (nginx on a non-default port)
# ---------------------------------------------------------------------
TINYMRP_URL=http://tinymrp-lan.company.local

# ---------------------------------------------------------------------
# REQUIRED 2/4 - where the CAD deliverables live on this machine.
# Use FORWARD slashes. This folder must exist and be writable by the
# account running the TinyMRP service: uploads, thumbnails and extra files
# are written underneath it.
# ---------------------------------------------------------------------
FILES_LOCAL_ROOT=C:/TinyMRP/data/deliverables

# ---------------------------------------------------------------------
# REQUIRED 3/4 and 4/4 - two independent random secrets, 32+ characters.
# The app refuses to start if either is missing, shorter than 16
# characters, or a placeholder. It never invents its own: a generated key
# changes on restart, and an application that re-keys itself cannot tell a
# forged session from a real one.
#
# Generate each of them with:
#   powershell -c "[guid]::NewGuid().ToString('N') + [guid]::NewGuid().ToString('N')"
# ---------------------------------------------------------------------
SECRET_KEY=REPLACE-WITH-A-64-CHAR-RANDOM-VALUE
SECURITY_PASSWORD_SALT=REPLACE-WITH-A-DIFFERENT-64-CHAR-RANDOM-VALUE

########################################################################
# Below here: defaults that work. Change only with a reason.
########################################################################

# MongoDB on this machine. Bind Mongo to 127.0.0.1 in mongod.cfg so the
# database is never reachable from the LAN.
MONGO_URI=mongodb://127.0.0.1:27017/tinymrp-v2

# URL prefix nginx serves the deliverables under. Keep in step with the
# `location` blocks in nginx.lan.conf, which handle both cases.
FILES_URL_PREFIX=/Deliverables

# Managed files are served through the app so permissions are enforced.
# Setting this true would publish every deliverable to anyone who guesses
# a URL.
FILES_PUBLIC_URLS=false

# X-Accel offload: the app authorises the request, then hands nginx the
# file to stream. Matches the `internal` location ^~ /__files/ block in
# nginx.lan.conf, so change both together or neither. It matters more here
# than elsewhere because waitress is single-process - streaming a 200 MB
# STEP file through the app occupies a worker thread for its whole
# download. Clear it to "" if you replace nginx with something that has no
# X-Accel-Redirect equivalent (Caddy, for one).
FILES_ACCEL_REDIRECT_PREFIX=/__files

# CSP and the other security response headers.
SECURITY_HEADERS_ENABLED=true

# nginx is the single reverse proxy in front of waitress. Set 0 if you
# expose waitress on port 8000 directly instead: with no proxy overwriting
# them, X-Forwarded-* headers are client input, and a forged
# X-Forwarded-For gives each request its own rate-limit bucket.
TINYMRP_TRUSTED_PROXY_HOPS=1

# There is no TLS on this deployment, so nothing may redirect to https.
FORCE_HTTPS=false

# CORS defaults to TINYMRP_URL. Only set this if a DIFFERENT origin must
# call the API from a browser - for example if some users reach the server
# by IP and others by name.
# TINYMRP_ALLOWED_ORIGINS=http://tinymrp-lan.company.local,http://192.168.0.25
TINYMRP_CORS_CREDENTIALS=true

# Rate limiting. waitress runs one process, so in-memory counters are a
# real budget here and Redis is not required.
# RATE_LIMIT_ENABLED=true
# RATE_LIMIT_LOGIN=10 per minute;100 per hour

# Logging. Written to the service log configured by
# install_tinymrp_service.ps1.
LOG_LEVEL=INFO
LOG_FORMAT=text

# First administrator. Leave seeding off and create the account with the
# CLI (see the guide) so the password is never stored in this file. If you
# do use it, both values are required and the password must be 12+
# characters; blank them out again once the account exists.
TINYMRP_SEED_ADMIN=false
# TINYMRP_ADMIN_EMAIL=admin@company.com
# TINYMRP_ADMIN_PASSWORD=

# Evaluation dataset and demo logins. Prefer `flask demo install`, which
# creates them once and prints the passwords, over leaving this on. This is
# only the initial default; the admin dashboard can toggle it at runtime.
ALLOW_PERMISSION_TEST_DATA=false

# Upload ceilings, sized for typical CAD packages. Raise for very large
# assemblies, and raise nginx client_max_body_size to match.
#
# TINYMRP_MAX_CONTENT_MB is the hard HTTP request cap and defaults to
# min(UPLOAD_PACK_MAX_ZIP_MB, 200), so raising only the pack limits still
# yields HTTP 413. Set it explicitly when you raise them.
UPLOAD_PACK_MAX_ZIP_MB=500
UPLOAD_PACK_MAX_FILE_MB=200
UPLOAD_PACK_MAX_FILES=5000
# TINYMRP_MAX_CONTENT_MB=500
EXTRA_FILES_ALLOWED=true

# API tokens issued to the SolidWorks add-in.
# API_TOKEN_DEFAULT_TTL_DAYS=90
# API_TOKEN_MAX_TTL_DAYS=365
