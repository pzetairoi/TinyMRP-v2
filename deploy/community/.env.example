# Copy to .env only for manual operation. The installers generate all secrets.
COMPOSE_PROJECT_NAME=tinymrp-community

# An explicit release tag is mandatory. Never use latest for an installed stack.
TINYMRP_IMAGE_REPOSITORY=ghcr.io/pzetairoi/tinymrp-app
TINYMRP_VERSION=v1.0.1

# localhost (default): 127.0.0.1; LAN: 0.0.0.0; domain: keep 127.0.0.1.
ACCESS_MODE=localhost
APP_BIND_IP=127.0.0.1
APP_PORT=5000

# The address users type. INCLUDE THE SCHEME, and keep the host and port in
# step with ACCESS_MODE and APP_PORT above.
#
# This is not cosmetic. Its scheme is what tells the application whether to
# mark session cookies `Secure` and whether to emit the CSP
# upgrade-insecure-requests directive. Declare https:// on a plain-HTTP stack
# and the browser discards the session cookie, so every login bounces straight
# back to the login form with no error.
#   localhost : http://localhost:5000
#   lan       : http://192.168.1.50:5000
#   domain    : https://tinymrp.example.com
TINYMRP_URL=http://localhost:5000

# How many reverse proxies you control sit in front of the app.
#   0 = localhost/lan (this compose publishes the app port directly)
#   1 = domain mode (Caddy terminates TLS in front)
# With no proxy overwriting them, X-Forwarded-* headers are client input: a
# forged X-Forwarded-For gives every request its own rate-limit bucket.
TINYMRP_TRUSTED_PROXY_HOPS=0

# Defaults to TINYMRP_URL. Set only when a DIFFERENT origin calls the API.
TINYMRP_ALLOWED_ORIGINS=http://localhost:5000

# Use an absolute path. Windows Docker Desktop accepts C:/TinyMRP/Deliverables.
DELIVERABLES_PATH=./deliverables

MONGO_DB=tinymrp
MONGO_ROOT_USER=tinymrp_root
MONGO_ROOT_PASSWORD=replace-with-generated-root-secret
MONGO_APP_USER=tinymrp_app
MONGO_APP_PASSWORD=replace-with-generated-app-secret
SECRET_KEY=replace-with-generated-flask-secret-at-least-32-characters
SECURITY_PASSWORD_SALT=replace-with-generated-salt-at-least-32-characters

# Used once by the installers, then removed from the persistent configuration.
TINYMRP_SEED_ADMIN=true
TINYMRP_ADMIN_EMAIL=admin@example.com
TINYMRP_ADMIN_PASSWORD=replace-with-a-unique-strong-password

# Optional per-host worker override. Blank uses the image's conservative default.
WEB_CONCURRENCY=
LOG_LEVEL=INFO
LOG_FORMAT=text
BACKUP_KEEP_DAYS=14
BACKUP_KEEP_COUNT=8
BACKUP_MAX_TOTAL_GB=10
# The floor that actually matters. The three limits above bound the backup
# folder; these bound the DISK, which is what runs out. Whichever is larger
# wins. Checked before a backup as well as after: if there is not room even
# after pruning, the backup refuses to run and keeps what you already have.
BACKUP_MIN_FREE_GB=5
BACKUP_MIN_FREE_PCT=10

# Domain mode only: docker compose --profile domain up -d.
TINYMRP_DOMAIN=tinymrp.example.com
ACME_EMAIL=admin@example.com
CADDY_BIND_IP=0.0.0.0
