# Copy to .env only for manual operation. The installers generate all secrets.
COMPOSE_PROJECT_NAME=tinymrp-community

# An explicit release tag is mandatory. Never use latest for an installed stack.
TINYMRP_IMAGE_REPOSITORY=ghcr.io/pzetairoi/tinymrp-app
TINYMRP_VERSION=v1.0.1

# localhost (default): 127.0.0.1; LAN: 0.0.0.0; domain: keep 127.0.0.1.
ACCESS_MODE=localhost
APP_BIND_IP=127.0.0.1
APP_PORT=5000
TINYMRP_ALLOWED_ORIGINS=http://localhost:5000
FORCE_HTTPS=false

# Use an absolute path. Windows Docker Desktop accepts C:/TinyMRP/Deliverables.
DELIVERABLES_PATH=./deliverables

MONGO_DB=tinymrp
MONGO_ROOT_USER=tinymrp_root
MONGO_ROOT_PASSWORD=replace-with-generated-root-secret
MONGO_APP_USER=tinymrp_app
MONGO_APP_PASSWORD=replace-with-generated-app-secret
SECRET_KEY=replace-with-generated-flask-secret-at-least-32-characters
SECURITY_PASSWORD_SALT=replace-with-generated-salt-at-least-32-characters

# Used once by the installers, then removed from the persistent configuration.
TINYMRP_SEED_ADMIN=true
TINYMRP_ADMIN_EMAIL=admin@example.com
TINYMRP_ADMIN_PASSWORD=replace-with-a-unique-strong-password

# Optional per-host worker override. Blank uses the image's conservative default.
WEB_CONCURRENCY=
LOG_LEVEL=INFO
LOG_FORMAT=text
BACKUP_KEEP_DAYS=14
BACKUP_KEEP_COUNT=8
BACKUP_MAX_TOTAL_GB=10

# Domain mode only: docker compose --profile domain up -d.
TINYMRP_DOMAIN=tinymrp.example.com
ACME_EMAIL=admin@example.com
CADDY_BIND_IP=0.0.0.0
